    },
    "koishi": {
        "description": {
            "zh": "ChatLuna Agent 模式的一部分功能集（网络请求、定时任务、Koishi 命令执行等）",
            "en": "Core functionalities for ChatLuna's agent mode (image gen, code exec, network, file ops, scheduling, memory, Koishi cmds, etc.)"
