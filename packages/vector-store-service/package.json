{
  "name": "koishi-plugin-chatluna-vector-store-service",
  "description": "vector store service for chatluna",
  "version": "1.3.0-alpha.0",
  "main": "lib/index.cjs",
  "module": "lib/index.mjs",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "overrides": {
    "@langchain/core": "0.3.62",
    "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
  },
  "pnpm": {
    "overrides": {
      "@langchain/core": "0.3.62",
      "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
    }
  },
  "dependencies": {
    "@chatluna/luna-vdb": "^0.0.11",
    "@langchain/community": "0.3.48",
    "@langchain/core": "0.3.62",
    "@langchain/redis": "^0.1.1",
    "redis": "^4.7.0",
    "zod-to-json-schema": "3.23.5"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "@zilliz/milvus2-sdk-node": "^2.5.7",
    "atsc": "^2.1.0",
    "faiss-node": "^0.5.1",
    "koishi": "^4.18.7"
  },
  "peerDependencies": {
    "@zilliz/milvus2-sdk-node": "^2.5.7",
    "faiss-node": "^0.5.1",
    "koishi": "^4.18.7",
    "koishi-plugin-chatluna": "^1.3.0-alpha.46"
  },
  "peerDependenciesMeta": {
    "@zilliz/milvus2-sdk-node": {
      "optional": true
    },
    "faiss-node": {
      "optional": true
    }
  },
  "koishi": {
    "description": {
      "zh": "ChatLuna 向量存储服务和 RAG 底层架构支持",
      "en": "Vector storage service and RAG underlying architecture support for ChatLuna"
    },
    "service": {
      "required": [
        "chatluna"
      ],
      "implements": [
        "chatluna_rag"
      ]
    }
  }
}
