{
    "name": "koishi-plugin-chatluna-multimodal-service",
    "description": "multimodal service for chatluna",
    "version": "1.4.0-alpha.3",
    "main": "lib/index.cjs",
    "module": "lib/index.mjs",
    "typings": "lib/index.d.ts",
    "files": [
        "lib",
        "dist",
        "resources"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "type": "module",
    "author": "dingyi222666 <dingyi222666@foxmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/ChatLunaLab/chatluna.git",
        "directory": "packages/service-image"
    },
    "license": "AGPL-3.0",
    "bugs": {
        "url": "https://github.com/ChatLunaLab/chatluna/issues"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "homepage": "https://github.com/ChatLunaLab/chatluna/tree/v1-dev/packages/service-image#readme",
    "scripts": {
        "build": "atsc -b"
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "service",
        "chatgpt",
        "gpt",
        "openai",
        "chatluna",
        "search"
    ],
    "dependencies": {
        "@langchain/core": "^0.3.80",
        "file-type": "16.5.4",
        "jimp": "^1.6.0",
        "omggif": "^1.0.10",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "@types/omggif": "^1.0.5",
        "atsc": "^2.1.0",
        "koishi": "^4.18.9",
        "koishi-plugin-ffmpeg-path": "^2.0.0"
    },
    "peerDependencies": {
        "koishi": "^4.18.9",
        "koishi-plugin-chatluna": "^1.4.0-alpha.30",
        "koishi-plugin-ffmpeg-path": "^2.0.0"
    },
    "peerDependenciesMeta": {
        "koishi-plugin-ffmpeg-path": {
            "optional": true
        }
    },
    "resolutions": {
        "@langchain/core": "^0.3.80",
        "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
    },
    "overrides": {
        "@langchain/core": "^0.3.80",
        "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
    },
    "pnpm": {
        "overrides": {
            "@langchain/core": "^0.3.80",
            "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
        }
    },
    "koishi": {
        "description": {
            "zh": "ChatLuna 多模态支持服务，图片读取支持，GIF 图片支持，语音文件支持",
            "en": "ChatLuna multimodal support service, provides image reading support for models that do not support images"
        },
        "service": {
            "required": [
                "chatluna"
            ],
            "optional": [
                "ffmpeg",
                "silk"
            ]
        }
    }
}
