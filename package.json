{
    "name": "@root/chatluna-koishi",
    "version": "1.0.0",
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "packageManager": "yarn@4.14.1",
    "private": true,
    "license": "AGPL-3.0",
    "scripts": {
        "process-dynamic-import": "yarn tsx ./scripts/processDynamicImport.ts",
        "fast-build": "yakumo build",
        "build": "yarn process-dynamic-import --lint && yarn fast-build shared-prompt-renderer && yarn fast-build core && yarn fast-build",
        "integration:build": "yarn fast-build shared-prompt-renderer && yarn fast-build core && yarn fast-build shared-adapter && yarn fast-build extension-agent && yarn fast-build adapter-openai-like",
        "integration": "yarn integration:build && node integration/chatluna-harness.cjs",
        "integration:scope": "yarn integration:build && node integration/local-scope-probe.cjs",
        "integration:no-op-file-writes": "yarn fast-build extension-agent && node integration/noop-file-writes-probe.cjs",
        "integration:stream-idle": "yarn fast-build shared-prompt-renderer && yarn fast-build core && yarn fast-build shared-adapter && node integration/stream-idle-probe.cjs",
        "integration:abort-propagation": "yarn fast-build shared-prompt-renderer && yarn fast-build core && yarn fast-build shared-adapter && yarn fast-build extension-agent && node integration/abort-propagation-probe.cjs",
        "integration:scratchpad-compression": "yarn fast-build shared-prompt-renderer && yarn fast-build core && node integration/scratchpad-compression-probe.cjs",
        "integration:model-context-token-probe": "yarn fast-build shared-prompt-renderer && yarn fast-build core && node integration/model-context-token-probe.cjs",
        "integration:sub-agent-plan-timeout": "yarn fast-build shared-prompt-renderer && yarn fast-build core && node integration/sub-agent-plan-timeout-probe.cjs",
        "integration:sub-agent-turn-count": "yarn fast-build shared-prompt-renderer && yarn fast-build core && node integration/sub-agent-turn-count-probe.cjs",
        "probe:tools": "node integration/tool-observation-probe.cjs",
        "integration:live": "yarn integration:build && node integration/chatluna-harness.cjs --live",
        "bench:doctor": "yarn tsx bench/agent-eval.ts doctor",
        "bench:context": "yarn tsx bench/agent-eval.ts context",
        "bench:report": "yarn tsx bench/agent-eval.ts report",
        "bench:aider": "yarn integration:build && yarn tsx --tsconfig bench/tsconfig.json bench/aider-eval.ts",
        "bench:aider:suite": "yarn tsx --tsconfig bench/tsconfig.json bench/aider-eval.ts suite",
        "bench:aider:report": "yarn tsx --tsconfig bench/tsconfig.json bench/aider-eval.ts report",
        "bench:terminal": "yarn integration:build && yarn tsx --tsconfig bench/tsconfig.json bench/terminal-bench-eval.ts",
        "bump": "yakumo version",
        "dep": "yakumo upgrade",
        "pub": "yakumo publish --tag latest",
        "pub:next": "yakumo publish --tag next",
        "lint": "yarn eslint packages --cache --ext=ts",
        "lint-fix": "yarn eslint packages --cache --ext=ts --fix"
    },
    "devDependencies": {
        "@initencounter/vits": "^0.0.3",
        "@koishijs/cache": "^2.1.0",
        "@koishijs/censor": "^1.1.0",
        "@koishijs/client": "^5.30.9",
        "@koishijs/plugin-console": "^5.30.11",
        "@koishijs/plugin-database-memory": "^3.7.0",
        "@koishijs/plugin-hmr": "^1.2.9",
        "@koishijs/plugin-mock": "^2.6.6",
        "@koishijs/plugin-server": "^3.2.9",
        "@koishijs/scripts": "^4.6.1",
        "@types/chai": "^4.3.20",
        "@types/he": "^1.2.3",
        "@types/js-yaml": "^4.0.9",
        "@types/marked": "^6.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.18.7",
        "@types/qrcode": "^1.5.5",
        "@typescript-eslint/eslint-plugin": "^7.18.1-alpha.3",
        "@typescript-eslint/parser": "^8.45.1-alpha.0",
        "atsc": "^2.1.0",
        "chai": "^4.4.1",
        "cross-env": "^7.0.3",
        "esbuild": "^0.25.10",
        "esbuild-register": "npm:@shigma/esbuild-register@^1.1.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.2",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-n": "^17.23.1",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-promise": "^7.2.1",
        "faiss-node": "^0.5.1",
        "he": "^1.2.0",
        "highlight.js": "^11.11.1",
        "https-proxy-agent": "^7.0.6",
        "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21",
        "js-yaml": "^4.1.0",
        "jsonc-parser": "^3.3.1",
        "koishi": "^4.18.9",
        "koishi-plugin-cache-database": "^2.1.0",
        "koishi-plugin-chatluna-storage-service": "^1.0.6",
        "koishi-plugin-markdown": "^1.1.1",
        "koishi-plugin-puppeteer": "^3.9.0",
        "marked": "^15.0.12",
        "marked-highlight": "^2.2.2",
        "marked-katex-extension": "^5.1.5",
        "mocha": "^9.2.2",
        "prettier": "^3.6.2",
        "qrcode": "^1.5.4",
        "socks-proxy-agent": "^8.0.5",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.2",
        "undici": "^6.21.3",
        "user-agents": "^2.0.0-alpha.679",
        "ws": "^8.18.3",
        "yakumo": "^1.0.0-beta.20",
        "yakumo-esbuild": "^1.0.0-beta.7",
        "yakumo-mocha": "^1.0.0-beta.2",
        "yakumo-tsc": "^1.0.0-beta.5",
        "yml-register": "^1.2.5",
        "zod": "3.25.76",
        "zod-to-json-schema": "^3.24.6"
    },
    "resolutions": {
        "@langchain/core": "^0.3.80",
        "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
    },
    "overrides": {
        "@langchain/core": "^0.3.80",
        "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
    },
    "pnpm": {
        "overrides": {
            "@langchain/core": "^0.3.80",
            "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
        }
    },
    "repository": "git@github.com:ChatLunaLab/chatluna.git",
    "author": "dingyi222666 <dingyi222666@foxmail.com>"
}
